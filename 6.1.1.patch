+      }
+      .share-as-gist-buttons button.secondary:hover:not(:disabled) {
+        background-color: #e0e0e0;
+      }
+      .share-as-gist-loading {
+        text-align: center;
+        padding: 24px;
+        color: #666;
+      }
+      .share-as-gist-success {
