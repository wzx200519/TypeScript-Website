+            },
+            body: JSON.stringify(gistData)
+          })
+          
+          if (!response.ok) {
+            const errorData = await response.json().catch(() => ({}))
+            const errorMsg = errorData.message || `Failed to create gist: ${response.status} ${response.statusText}`
