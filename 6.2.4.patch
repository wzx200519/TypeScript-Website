       } else if (!isNaN(parseInt(val, 10)) && playgroundDefaults[key] !== parseInt(val, 10)) {
         toSet = parseInt(val, 10)
+      } else {
+        const enumVal = tryParseEnumValue(key, val, ts)
+        if (enumVal !== undefined && playgroundDefaults[key] !== enumVal) {
+          toSet = enumVal
+        }
       }
 
       if (toSet !== undefined) returnedOptions[key] = toSet
@@ -100,6 +129,10 @@ export const getCompilerOptionsFromParams = (
