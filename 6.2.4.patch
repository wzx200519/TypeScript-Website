   return { ...settings, ...config.compilerOptions }
 }
 
+function tryParseEnumValue(
+  key: string,
+  val: string,
+  ts: typeof import("typescript")
+): number | undefined {
+  const enumMap: Record<string, any> = {
+    target: ts.ScriptTarget,
+    module: ts.ModuleKind,
+    moduleResolution: ts.ModuleResolutionKind,
+    jsx: ts.JsxEmit,
+  }
+
+  const tsEnum = enumMap[key]
+  if (!tsEnum) return undefined
+
+  const upperVal = val.toUpperCase()
+  for (const enumKey of Object.keys(tsEnum)) {
+    if (typeof tsEnum[enumKey] === "number" && enumKey.toUpperCase() === upperVal) {
+      return tsEnum[enumKey]
+    }
+  }
+  return undefined
+}
